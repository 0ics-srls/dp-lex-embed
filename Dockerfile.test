# Dockerfile.test - ProcMon builds this, runs the container, treats a non-zero exit as a test failure.
# pytest is the build gate (like `dotnet test` for the C# classes). Hermetic: tests marked `integration` need Docker
# (Postgres + pgvector) and are excluded here; they run locally. The whole repo is copied (.dockerignore keeps .venv/.git out).
FROM python:3.12-slim
WORKDIR /app
COPY requirements-dev.txt requirements.txt ./
RUN pip install --no-cache-dir -r requirements-dev.txt
COPY . .
ENV PYTHONPATH=/app/src
ENTRYPOINT ["python", "-m", "pytest", "-q", "-m", "not integration"]
